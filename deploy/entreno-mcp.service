# /etc/systemd/system/entreno-mcp.service — servidor MCP (lo instala setup-mcp.sh)
#   systemctl status entreno-mcp   ·   journalctl -u entreno-mcp -f

[Unit]
Description=Entreno - servidor MCP (conector de Claude)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=entreno
Group=entreno
WorkingDirectory=/srv/entreno/mcp_server
# mcp_server/.env: MCP_PUBLIC_URL, MCP_PASSWORD_HASH (y DATABASE_URL sale de backend/.env)
ExecStart=/srv/entreno/mcp_server/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8021 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
