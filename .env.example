# Copiar a backend/.env y rellenar.

# Cadena de conexión Postgres. Supabase → Project Settings → Database →
# "Connection string" (URI, modo "Session"). Ejemplo:
# postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Secreto para firmar la cookie de sesión (cualquier cadena larga y aleatoria).
SESSION_SECRET=

# PIN inicial: sólo se usa la primera vez, para crear el único usuario.
# Después se puede borrar esta línea.
INITIAL_PIN=

# 1 en producción (HTTPS). 0 para probar en http://localhost.
COOKIE_SECURE=0
